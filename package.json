{
  "name": "vyron-browser",
  "productName": "VYRON",
  "version": "1.0.0",
  "description": "A customisable desktop browser with privacy controls",
  "main": "src/main.js",
  "author": "AzureMC-projects",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "dist": "npm run check && electron-builder",
    "dist:win": "npm run check && electron-builder --win",
    "dist:mac": "npm run check && electron-builder --mac",
    "dist:linux": "npm run check && electron-builder --linux"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.azuremc.vyron",
    "productName": "VYRON",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.11.0",
    "cross-fetch": "^4.1.0"
  }
}
